<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to hback.xml and edit it. Each <backup> is one backup.
  hback re-reads the file while it runs, and a backup you edit runs straight away.

  Paths, patterns, addresses and passwords are written between <![CDATA[ and ]]> here.
  hback reads what is between those two marks exactly as you wrote it. So an & or a < in a path
  or a password needs nothing done to it, and a backslash is one backslash. That is the way to
  write values of this kind, because they are the ones likely to hold such a character.

  hback does not ask for CDATA anywhere. The names and numbers here are written without it, and
  any value can be. Without it an & has to be written &amp; and a < has to be written &lt;.
-->
<hback>

  <backup>
    <name>projects</name>

    <!-- When it runs. This is Com.H.Threading.Scheduler's <sys> element.
         <interval> is in milliseconds: 3600000 is every hour.
         Or run once a day with <time>01:00</time> instead. If the machine was off at that time,
         the backup runs when hback next starts that day.
         Leave <sys> out for a backup that only runs when you type "hback run projects". -->
    <sys>
      <interval>3600000</interval>
    </sys>

    <!-- What to back up: one folder or file per line. "~" is your home folder. -->
    <sources><![CDATA[
      C:\code
      ~\Documents\notes
    ]]></sources>

    <!-- What to leave out, one pattern per line, written like a .gitignore line:
           node_modules     that name, in any folder
           bin/             folders only
           *.log            a wildcard
           /build/output    a path from the top of each source folder
           C:/code/old/     a full path
         hback does not read your .gitignore files. They exclude things a backup should keep,
         like .env files and local settings. -->
    <exclude><![CDATA[
      node_modules/
      bin/
      obj/
      .vs/
      __pycache__/
      .venv/
      *.tmp
    ]]></exclude>

    <!-- Where it goes. Give every backup a folder of its own.
           A folder:        D:\backups\laptop        (it must exist, hback won't create it)
           An SFTP server:  sftp://user@host:22/backups/laptop
                            sftp://user@host/~/backups/laptop    ("~" is the login folder)
         To send the same files to more than one place, repeat <destination>, or list the places
         one per line in <destinations>, the way <sources> lists folders. -->
    <destination><![CDATA[sftp://hussein@backup.example.com:22/backups/laptop]]></destination>

    <!-- For SFTP, a private key (OpenSSH or PEM format), with <passphrase> if it has one... -->
    <private_key><![CDATA[~\.ssh\id_ed25519]]></private_key>
    <!-- ...or a password.
    <password><![CDATA[secret]]></password> -->

    <!-- Optional. The server's host key, as "ssh-keygen -lf" prints it. Without it, hback remembers
         the key the server shows on the first connection and refuses any other key later. -->
    <!-- <host_key>SHA256:abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQ</host_key> -->

    <!-- Optional. How many days the previous copy of a changed or deleted file is kept under
         history/ at the destination. Default 30. Zero keeps no history. -->
    <keep_history_days>30</keep_history_days>

    <!-- Optional. How many files are copied at once. Default 4. -->
    <!-- <parallel>4</parallel> -->

    <!-- Optional. How much of each source's own path is repeated at the destination.
         For the file C:\code\app\a.cs of the source C:\code:
           full   all of it:               current/C/code/app/a.cs   (the default)
           name   the source's own name:   current/code/app/a.cs
           none   none of it:              current/app/a.cs -->
    <!-- <source_path>full</source_path> -->

    <!-- Optional. Other names or places for hback's three folders, inside the destination.
         "." as the current folder puts the files straight into the destination folder. -->
    <!-- <current_folder><![CDATA[current]]></current_folder>
    <history_folder><![CDATA[history]]></history_folder>
    <partial_folder><![CDATA[partial]]></partial_folder> -->
  </backup>

  <!--
    Another use of the same thing: handing the contents of one folder on to several machines.
    Take the comment marks away from around the backup below to use it.

    With source_path none and current_folder "." the files arrive in each destination folder just
    as they are in C:\deploy\site, with no folders of hback's around them. What a run replaces or
    removes is kept for a week in .hback\history inside that folder.

    The private key is written once and holds for every destination. The last destination has a
    setting of its own, so it is written with its address in <path> and the setting beside it.
    A list is either lines, as <sources> is, or <destination> elements as here, not both.
  -->
  <!--
  <backup>
    <name>site</name>
    <sys>
      <interval>300000</interval>
    </sys>
    <sources><![CDATA[
      C:\deploy\site
    ]]></sources>
    <source_path>none</source_path>
    <current_folder><![CDATA[.]]></current_folder>
    <keep_history_days>7</keep_history_days>
    <private_key><![CDATA[~\.ssh\id_ed25519]]></private_key>
    <destinations>
      <destination><![CDATA[\\web1\apps\site]]></destination>
      <destination><![CDATA[sftp://deploy@web2.example.com/var/www/site]]></destination>
      <destination>
        <name>archive</name>
        <path><![CDATA[sftp://deploy@archive.example.com/srv/sites/site]]></path>
        <keep_history_days>365</keep_history_days>
      </destination>
    </destinations>
  </backup>
  -->

</hback>
