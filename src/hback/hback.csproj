<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hback</AssemblyName>
    <RootNamespace>HBack</RootNamespace>
    <Version>0.4.0</Version>
    <Authors>Hussein Al Bayati</Authors>
    <Description>Copies the folders you pick to a local folder or an SFTP server, on a schedule, as plain files.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The line numbers of an error travel inside the program, so there is no .pdb file to ship. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- What a release download is made of. "dotnet publish -r linux-x64 (or another system)
       with the self-contained switch" gives the program as one file with the .NET runtime inside it,
       so the machine it runs on needs no .NET installed.
       SQLite's native library stays a second file beside the program. Packing it in as well
       (IncludeNativeLibrariesForSelfExtract) would have the program unpack it into a temp or home
       folder before every first start, and a service account does not always have one it can
       write to. The program is not compressed either (EnableCompressionInSingleFile): the download
       is an archive already, and a compressed program has to hold all of itself in memory. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="hback.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Com.H.Threading.Scheduler.DI" Version="11.0.0" />
    <PackageReference Include="Com.H.Net.Ssh" Version="11.0.0" />
    <PackageReference Include="Com.H.Data.Common" Version="11.0.0" />
    <PackageReference Include="Com.H.Extensions.Logging.File" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="11.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample is shipped beside the binary. The real hback.xml is the user's and is never
         overwritten by a build or a publish. -->
    <None Include="hback.sample.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
